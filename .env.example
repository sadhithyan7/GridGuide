APP_NAME=gridguide
ENVIRONMENT=local

# Database (Postgres + pgvector)
DATABASE_URL=postgresql://app:app@localhost:5432/rag

# LLM provider: "fake" (no key needed) or "openai_compat" (needs a key below)
LLM_PROVIDER=fake
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3.1:8b
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE_SECONDS=0.5

# Second model used only when the main one is unavailable. Empty = no fallback.
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=

# Cost tracking (per million tokens). Set 0.0 for free/local models.
PRICE_INPUT_PER_MILLION=0.0
PRICE_OUTPUT_PER_MILLION=0.0
COST_LOG_PATH=logs/cost.jsonl
